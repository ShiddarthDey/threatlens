# Copy to .env and fill in. All keys are FREE.

# AlienVault OTX (required only for --source otx): free account at otx.alienvault.com
OTX_API_KEY=

# NVD (optional, raises rate limit 5->50 req/30s): https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=

# LLM endpoint. Default = local Ollama (http://localhost:11434), no key needed.
# For hosted OpenAI-compatible APIs (Groq, Together, vLLM):
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_API_KEY=
